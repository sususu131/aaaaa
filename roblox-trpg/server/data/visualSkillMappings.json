      "infer": ["angel", "avian"]
    },
    {
      "if": ["demon_wings", "horns"],
      "infer": ["demon", "devil"]
    },
    {
      "if": ["robot", "technology", "mechanical"],
      "infer": ["robot", "cyborg"]
    },
    {
      "if": ["shield", "sword", "knight_helmet"],
      "infer": ["knight", "paladin"]
    },
    {
      "if": ["goggles", "overalls", "tool_belt"],
      "infer": ["engineer", "mechanic"]
    },
    {
