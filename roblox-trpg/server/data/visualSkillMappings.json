      "infer": ["scientist"]
    },
    {
      "if": ["stethoscope", "lab_coat", "medical_mask"],
      "infer": ["doctor", "medic"]
    },
    {
      "if": ["bow", "hood", "quiver"],
      "infer": ["ranger", "hunter"]
    },
    {
      "if": ["katana", "samurai", "armor"],
      "infer": ["samurai", "duelist"]
    }
