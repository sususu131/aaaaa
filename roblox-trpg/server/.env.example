# 复制为 .env 或直接以环境变量启动。API Key 只存服务端，绝不进浏览器。
# 使用 shell 方式示例：
#   AI_API_KEY=sk-xxx AI_BASE_URL=https://api.openai.com/v1 AI_MODEL=gpt-4o-mini npm run dev

# ── AI GM（OpenAI 兼容 API）──
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Context 预算（tokens）与限流
AI_CONTEXT_BUDGET=100000
AI_RATE_PER_PLAYER=6
AI_RATE_PER_ROOM=12

# Context Viewer：all（开发期）/ host / none
CONTEXT_VIEWER_SCOPE=all

# 服务端口
PORT=3000

# ── 阶段3：AI Agent ──
# API 格式：openai（OpenAI/DeepSeek-OpenAI 兼容）或 anthropic（Anthropic/DeepSeek-Anthropic 风格）
AI_API_FORMAT=openai
# DeepSeek 示例：AI_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek-v4-flash
# 第三方网关返回 Anthropic 风格时：AI_API_FORMAT=anthropic
AI_MAX_TOOL_ROUNDS=6
AI_TIMEOUT_MS=25000

# Web Search 适配（阶段3 第十三节，可选）：null | serper
SEARCH_PROVIDER=null
SERPER_API_KEY=
